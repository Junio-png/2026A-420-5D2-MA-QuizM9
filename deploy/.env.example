# Copier en .env (le fichier .env n'est pas versionné : il contient des secrets).

# OWNER : votre compte GitHub, en minuscules.
# TAG   : latest, ou un tag sha-xxxxxxx pour épingler une version.
OWNER=votre-compte
TAG=latest

# Le mot de passe de la base, choisi ici une fois pour toutes : il crée
# l'utilisateur au premier démarrage et sert ensuite à l'API.
POSTGRES_PASSWORD=changez-moi

# La clé qui signe les cookies de session : 32 caractères au moins, sinon
# l'API refuse de démarrer. Pour en produire une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# L'application OAuth GitHub de CETTE machine (son URL de rappel est celle
# de la machine, pas localhost).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
