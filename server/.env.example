# Copier en server/.env (le fichier .env n'est pas versionné : il contient des
# secrets). `npm run dev` le lit au démarrage.

# L'application OAuth créée sur GitHub (Settings, Developer settings, OAuth
# Apps). L'URL de rappel déclarée là-bas : http://localhost:5173/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# La clé qui signe le cookie de session : une longue chaîne aléatoire.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ATELIER XSS (exercice 13) : à 1, ajoute un sélecteur pour changer d'identité
# sans mot de passe (devenir Alice, la victime, etc.). Porte dérobée volontaire,
# éteinte par défaut ; ne jamais l'activer ailleurs qu'en classe.
# DEV_LOGIN=1

# La base : la valeur par défaut est celle du service postgres de compose.yml.
# DATABASE_URL=postgres://quizm9:quizm9@localhost:5432/quizm9

# Sans Docker Desktop sur ce poste : SQLite en secours, un fichier, rien à
# installer. Le chemin est relatif à server/.
# DATABASE_URL=sqlite:data/quizm9.db
